# Public site URL used for canonical links, sitemap, and social metadata.
NEXT_PUBLIC_SITE_URL=https://research.datascienceclub.org

# Admin sign-in. Required in production; locally it falls back to "admin".
ADMIN_PASSWORD=change-me

# Optional: sign cookie sessions with a dedicated secret. Defaults to a value
# derived from ADMIN_PASSWORD, so rotating the password invalidates sessions.
# ADMIN_SECRET=

# Optional: persist admin edits by committing content/*.json to GitHub.
# Without these, edits are written to the local content/ directory.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main
